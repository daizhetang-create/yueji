{
  "version": 1,
  "collections": [
    {
      "name": "users",
      "description": "微信用户与状态",
      "indexes": [{ "name": "status_updated", "fields": [{ "field": "status", "order": "asc" }, { "field": "updatedAt", "order": "desc" }] }]
    },
    {
      "name": "plans",
      "description": "七日约，只有支付回调确认后才能写入 active",
      "indexes": [
        { "name": "openid_state_created", "fields": [{ "field": "openid", "order": "asc" }, { "field": "state", "order": "asc" }, { "field": "createdAt", "order": "desc" }]},
        { "name": "outTradeNo_unique", "unique": true, "fields": [{ "field": "outTradeNo", "order": "asc" }]}
      ]
    },
    {
      "name": "checkins",
      "description": "每日打卡，文档 ID 由 openid+日期+任务类型组成",
      "indexes": [
        { "name": "openid_date", "fields": [{ "field": "openid", "order": "asc" }, { "field": "date", "order": "asc" }]},
        { "name": "plan_date", "fields": [{ "field": "planId", "order": "asc" }, { "field": "date", "order": "asc" }]}
      ]
    },
    {
      "name": "reflections",
      "description": "用户主动创建的实践随记；不参与完成或资金判定",
      "indexes": [
        { "name": "openid_date", "fields": [{ "field": "openid", "order": "asc" }, { "field": "date", "order": "asc" }]},
        { "name": "task_date", "fields": [{ "field": "taskId", "order": "asc" }, { "field": "date", "order": "asc" }]}
      ]
    },
    {
      "name": "checkin_events",
      "description": "真实约池上线前启用的不可覆盖打卡事件与验证结果",
      "indexes": [
        { "name": "plan_created", "fields": [{ "field": "planId", "order": "asc" }, { "field": "createdAt", "order": "asc" }]},
        { "name": "openid_created", "fields": [{ "field": "openid", "order": "asc" }, { "field": "createdAt", "order": "desc" }]}
      ]
    },
    {
      "name": "orders",
      "description": "微信支付订单，金额单位均为分",
      "indexes": [
        { "name": "outTradeNo_unique", "unique": true, "fields": [{ "field": "outTradeNo", "order": "asc" }]},
        { "name": "openid_state", "fields": [{ "field": "openid", "order": "asc" }, { "field": "state", "order": "asc" }]}
      ]
    },
    {
      "name": "settlements",
      "description": "计划到期结算；本金退款、约池贡献与共同奖励分账记录",
      "indexes": [
        { "name": "planId_unique", "unique": true, "fields": [{ "field": "planId", "order": "asc" }]},
        { "name": "state_dueAt", "fields": [{ "field": "state", "order": "asc" }, { "field": "dueAt", "order": "asc" }]}
      ]
    },
    {
      "name": "pool_cycles",
      "description": "共同约池批次；当前只保留机制演示结构，不启用真实转账",
      "indexes": [
        { "name": "cycleId_unique", "unique": true, "fields": [{ "field": "cycleId", "order": "asc" }]},
        { "name": "state_lockedAt", "fields": [{ "field": "state", "order": "asc" }, { "field": "lockedAt", "order": "asc" }]}
      ]
    },
    {
      "name": "pool_entries",
      "description": "每个计划的本金退回、约池贡献、共享资格与奖励预览",
      "indexes": [
        { "name": "planId_unique", "unique": true, "fields": [{ "field": "planId", "order": "asc" }]},
        { "name": "cycle_eligibility", "fields": [{ "field": "cycleId", "order": "asc" }, { "field": "eligible", "order": "asc" }]}
      ]
    },
    {
      "name": "reward_payouts",
      "description": "未来真实共同奖励转出幂等账；合规与支付能力通过前保持禁用",
      "indexes": [
        { "name": "payoutNo_unique", "unique": true, "fields": [{ "field": "payoutNo", "order": "asc" }]},
        { "name": "state_created", "fields": [{ "field": "state", "order": "asc" }, { "field": "createdAt", "order": "asc" }]}
      ]
    },
    {
      "name": "audit_logs",
      "description": "支付、打卡、结算关键操作审计",
      "indexes": [{ "name": "entity_created", "fields": [{ "field": "entityId", "order": "asc" }, { "field": "createdAt", "order": "desc" }] }]
    }
  ],
  "security": "所有集合默认仅云函数可读写；小程序端不直接访问数据库"
}
