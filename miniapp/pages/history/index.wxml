<view class="page">
  <text class="eyebrow">最近 7 天</text>
  <text class="title">记录</text>
  <text class="summary">{{completeDays}} 天全部完成</text>

  <view class="week">
    <view class="day {{item.full ? 'full' : ''}}" wx:for="{{days}}" wx:key="key">
      <text>周{{item.weekday}}</text>
      <strong>{{item.day}}</strong>
      <text class="day-count">{{item.completed || '·'}}</text>
    </view>
  </view>

  <view class="today-list">
    <text class="section-label">今天</text>
    <view class="record" wx:for="{{tasks}}" wx:key="id">
      <view class="dot {{item.done ? 'done' : ''}}"></view>
      <text>{{item.title}}</text>
      <text class="record-status">{{item.done ? '完成' : '未完成'}}</text>
    </view>
  </view>
</view>
