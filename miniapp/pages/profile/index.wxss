.identity-card { min-height: 170rpx; margin-top: 52rpx; padding: 28rpx; display: grid; grid-template-columns: 84rpx 1fr auto; gap: 22rpx; align-items: center; border-radius: 38rpx; background: #1d2320; color: #ffffff; box-shadow: 0 20rpx 48rpx rgba(29, 35, 32, .13); }
.avatar { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; background: #c7ef65; color: #1d2320; font-size: 35rpx; font-weight: 750; }
.identity-card > view:nth-child(2) text { display: block; }
.identity-card > view:nth-child(2) text:first-child { font-size: 29rpx; font-weight: 680; }
.identity-card > view:nth-child(2) text:last-child { margin-top: 12rpx; color: #aeb4ae; font-size: 19rpx; }
.identity-card > text { padding: 8rpx 12rpx; border: 1rpx solid #414843; border-radius: 16rpx; color: #c9cec9; font-size: 17rpx; }

.group-label { display: block; margin: 54rpx 6rpx 18rpx; color: #777d76; font-size: 20rpx; font-weight: 650; }
.settings { overflow: hidden; }
.settings button { min-height: 116rpx; margin: 0; padding: 0 24rpx; display: grid; grid-template-columns: 64rpx 1fr 24rpx; gap: 18rpx; align-items: center; border-radius: 0; border-bottom: 1rpx solid #eef0eb; background: transparent; font-size: 27rpx; text-align: left; }
.settings button:last-child { border-bottom: 0; }
.settings button > view:nth-child(2) text { display: block; }
.settings .setting-value { margin-top: 8rpx; color: #777d76; font-size: 19rpx; }
.settings button > text:last-child { color: #b5b9b3; font-size: 34rpx; text-align: right; }
.setting-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #eff0eb; color: #626862; font-size: 27rpx; font-weight: 650; }
.setting-icon.accent { background: #eafaC3; color: #536e1f; }
.setting-icon.danger { background: #fbe9e7; color: #be5252; }
.danger-group button > view:nth-child(2) text:first-child { color: #b34f4f; }
.about { margin-top: 82rpx; display: flex; flex-direction: column; align-items: center; color: #a0a49e; }
.about view { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #e5e7e0; font-size: 20rpx; }
.about text { margin-top: 13rpx; font-size: 19rpx; }
.about text:last-child { margin-top: 8rpx; color: #babdb8; font-size: 16rpx; }
